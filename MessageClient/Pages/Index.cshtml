@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center ">
    <h1 class="display-4">Welcome</h1>
    <p class="fs-4">Here you can write a message.</a></p>
    <textarea id="textInput" class="bg-gradient rounded-pill w-50 border-dark shadow m-5 p-4 text-break" type="text" placeholder="Write here..." maxlength="128"></textarea>
    <div class="d-flex gap-5 justify-content-center m-3 fs-6">
        <button id="btnClear" type="button" class="nav-link text-dark rounded-pill">Clear</button>
        <button id="btnSend" type="button" class="nav-link text-success rounded-pill">Send</button>
    </div>
</div>

<script>
        var textInput = document.getElementById('textInput');
    var buttonClear = document.getElementById('btnClear');
    var buttonSend = document.getElementById('btnSend');

    buttonClear.onclick = function () {
        textInput.value = '';
    };

    buttonSend.onclick = async function () {
        const messageContent = textInput.value;

        if (!messageContent) {
            alert("Message cannot be empty!");
            return;
        }

        try {
            const response = await fetch("https://localhost:44373/api/messages", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({
                    Content: messageContent
                })
            });

            if (response.ok) {
                textInput.value = '';
                alert("Message sent successfully!");
            } else {
                alert("Error sending message: " + response.status);
            }
        } catch (error) {
            console.error("Error:", error);
            alert("Failed to send message: " + error.message);
        }
    };
</script>